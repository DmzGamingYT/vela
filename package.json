{
  "name": "vela",
  "productName": "Vela",
  "desktopName": "Vela",
  "version": "0.3.44",
  "description": "Vela — un navigateur de travail : espaces, vue scindée, sessions gardées, notes et agent local.",
  "homepage": "https://site-cd854ef5da03437a8f42ade87147e33d.freebuff.page/",
  "license": "MIT",
  "author": {
    "name": "Vela contributors",
    "email": "contact@example.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "dist:mac": "npm run build && electron-builder --mac -c.directories.output=release/mac",
    "dist:win": "npm run build && electron-builder --win -c.directories.output=release/win",
    "dist:linux": "npm run build && electron-builder --linux -c.directories.output=release/linux",
    "site:build": "node site/tools/releases.mjs && node site/tools/build.mjs",
    "site:check": "node scripts/check-site-release.cjs",
    "site:check:served": "node scripts/check-site-release.cjs --served",
    "site:releases": "node site/tools/releases.mjs",
    "native:gen": "node scripts/gen-blocklist-rs.cjs",
    "native:build": "node scripts/gen-blocklist-rs.cjs && cargo build --release --manifest-path native/vela-blocklist/Cargo.toml && cp native/vela-blocklist/target/release/libvela_blocklist.dylib native/vela-blocklist/vela-blocklist.node",
    "native:store": "node scripts/build-store.cjs"
  },
  "dependencies": {
    "electron-chrome-extensions": "^4.10.0",
    "electron-updater": "^6.8.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@electron/universal": {
      "minimatch@^9.0.3": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch@^10.2.5": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch@^10.2.4": "^11.0.1"
    },
    "eslint": {
      "minimatch@^10.2.6": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch@^10.2.2": "^11.0.1"
    }
  }
}
